  <widget class="QWidget" name="centralwidget">
   <property name="styleSheet">
    <string notr="true">QWidget {
    background: #f6f4ee;
    color: #1f2937;
    font-family: "Segoe UI";
    font-size: 13px;
}
QFrame#headerFrame, QFrame.cardFrame, QFrame.sidePanel {
    background: #fffdf8;
    border: 1px solid #d7d2c7;
    border-radius: 16px;
}
QGroupBox {
    border: 1px solid #d8d3c8;
    border-radius: 14px;
    margin-top: 12px;
    font-weight: 700;
    background: #fffdfa;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
}
QPushButton {
    background: #f7f1e2;
    border: 1px solid #cbbd95;
    border-radius: 10px;
    padding: 8px 14px;
    font-weight: 600;
}
QPushButton:hover {
    background: #efe4c3;
}
QPushButton:pressed {
    background: #e3d4ab;
}
QPushButton#accentButton {
    background: #d97706;
    color: white;
    border-color: #b45309;
}
QPushButton#accentButton:hover {
    background: #ea8f22;
}
QLineEdit, QComboBox, QPlainTextEdit, QTextEdit {
    background: white;
    border: 1px solid #d2ccbf;
    border-radius: 10px;
    padding: 6px 8px;
}
QTabWidget::pane {
    border: 1px solid #d7d2c7;
    border-radius: 14px;
    top: -1px;
    background: #fffdfa;
}
QTabBar::tab {
    background: #e9e3d5;
    border: 1px solid #d1c9b7;
    border-bottom: none;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    padding: 9px 18px;
    margin-right: 4px;
    font-weight: 700;
}
QTabBar::tab:selected {
    background: #fffdfa;
}
QLabel#titleLabel {
    font-size: 28px;
    font-weight: 800;
}
QLabel#subtitleLabel {
    color: #5b6470;
    font-size: 14px;
}
QLabel.valueLabel {
    font-size: 22px;
    font-weight: 800;
}
QLabel.mutedLabel {
    color: #6b7280;
}
QFrame#logFrame {
    background: #fffdfa;
    border: 1px solid #d8d3c8;
    border-radius: 14px;
}
</string>
